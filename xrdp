#!/bin/bash

# 1. 检查是否以 root 权限运行
if [ "$EUID" -ne 0 ]; then
  echo "错误：请使用 root 权限 (sudo) 运行此脚本。"
  exit 1
fi

echo "========== 1. 更新系统软件包 =========="
apt-get update

echo "========== 2. 安装桌面、XRDP及所有排错依赖 =========="
# xfce4 及增强包：桌面环境
# xrdp, ssl-cert：远程服务及证书读取权限管理
# xserver-xorg-core, xorgxrdp：XRDP 底层 X 渲染桥接 (解决找不到 display 的问题)
# dbus-x11：进程间通信框架 (解决 root 启动桌面时无法分配 dbus 会话总线导致瞬间自毁)
# mesa-utils, libglx-mesa0, libgl1-mesa-dri：Mesa 渲染基础库 (解决无 GPU 云主机的 llvmpipe 软件渲染崩溃问题)
apt-get install -y xfce4 xfce4-goodies xrdp ssl-cert \
  xserver-xorg-core xorgxrdp dbus-x11 \
  mesa-utils libglx-mesa0 libgl1-mesa-dri

echo "========== 3. 解除 X 服务器启动权限限制 =========="
# 允许任何用户启动 X 服务器 (解决 Debian 默认只允许物理控制台用户启动桌面的安全策略)
echo "allowed_users=anybody" >/etc/X11/Xwrapper.config

echo "========== 4. 配置 XRDP 会话脚本 (startwm.sh) =========="
# 备份默认的启动脚本
cp /etc/xrdp/startwm.sh /etc/xrdp/startwm.sh.bak

# 4.1 在原版脚本第二行插入必要的环境变量修复 (清理 DBUS 冲突并强制使用纯软件渲染)
sed -i '2i unset DBUS_SESSION_BUS_ADDRESS\nunset XDG_RUNTIME_DIR\nexport LIBGL_ALWAYS_SOFTWARE=1\n' /etc/xrdp/startwm.sh

# 4.2 注释掉默认的 Xsession 兜底逻辑，强制指向 startxfce4
sed -i 's/^test -x \/etc\/X11\/Xsession/#test -x \/etc\/X11\/Xsession/g' /etc/xrdp/startwm.sh
sed -i 's/^exec \/bin\/sh \/etc\/X11\/Xsession/#exec \/bin\/sh \/etc\/X11\/Xsession/g' /etc/xrdp/startwm.sh
if ! grep -q "startxfce4" /etc/xrdp/startwm.sh; then
  echo "startxfce4" >>/etc/xrdp/startwm.sh
fi

# ==============================================================================
# 【可选项：极简版 startwm.sh 备用方案】
# 默认的 startwm.sh 会执行 /etc/X11/Xsession.d/ 下的标准初始化流程（加载环境变量、输入法等）。
# 如果遇到未知冲突导致闪退，你可以手动将 /etc/xrdp/startwm.sh 替换为以下极简代码。
# 极简版去除了所有外围组件，纯净且强制拉起桌面：
#
# cat > /etc/xrdp/startwm.sh << "EOF"
