echo "========== 5. 强制指定用户级会话配置 =========="
# 为新创建的用户设置默认会话
echo "xfce4-session" >/etc/skel/.xsession
# 为当前执行脚本的用户（通常是 root）设置默认会话
echo "xfce4-session" >~/.xsession

echo "========== 6. 配置 XRDP 强制使用 TLS 加密 =========="
cp /etc/xrdp/xrdp.ini /etc/xrdp/xrdp.ini.bak
# 将安全层强制设置为 tls (默认是 negotiate)
sed -i 's/^security_layer=.*/security_layer=tls/g' /etc/xrdp/xrdp.ini
# 禁用旧版 RDP 加密以提升安全性
sed -i 's/^crypt_level=.*/crypt_level=high/g' /etc/xrdp/xrdp.ini

echo "========== 7. 配置证书权限 =========="
# 将 xrdp 用户加入 ssl-cert 组，使其有权限读取 /etc/ssl/private/ 下的自签名私钥
adduser xrdp ssl-cert

echo "========== 8. 重启并清理环境 =========="
# 强制杀掉可能存在的僵尸 Xorg 进程并清理旧的锁文件，防止 display 端口被占死
killall Xorg 2>/dev/null
rm -rf /tmp/.X*

# 重启网络服务与会话管理服务
systemctl restart xrdp xrdp-sesman
systemctl enable xrdp

echo "========== 安装与配置全部完成！ =========="
echo "XRDP 现已运行，底层环境已修复，并强制使用 TLS 加密。"
echo "客户端连接警告：请勿使用 /bpp:8 色深或强制硬件加速参数。"
echo "推荐连接命令：xfreerdp3 /v:<服务器IP>:3389 /u:root /p:<密码> /bpp:24 +compression -wallpaper -themes /network:modem /sec:tls"

# 检查证书
openssl x509 -in /etc/xrdp/cert.pem -noout -fingerprint -sha256

