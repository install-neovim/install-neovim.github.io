#!/bin/bash

# ==============================================================
# NTFY 本地安全控制台 (极简稳定版 - 纯内存无痕运行)
# ==============================================================

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$EUID" -ne 0 ]; then
  echo -e "${RED}请使用 root 权限运行此脚本 (sudo bash setup_local_ntfy.sh)${NC}"
  exit 1
fi

echo -e "${CYAN}======================================================${NC}"
echo -e "${CYAN}        本地 NTFY 安全控制台 (极简稳定版)${NC}"
echo -e "${CYAN}======================================================${NC}"
echo ""

# 1. 自动清理旧环境与冲突端口 (绝杀 address already in use)
echo -e "${YELLOW}正在清理旧环境与残留进程...${NC}"
systemctl stop ntfy-local-web 2>/dev/null
# 强杀占用 50080 端口的进程
if command -v fuser &>/dev/null; then
  fuser -k 50080/tcp >/dev/null 2>&1
else
  killall ntfy >/dev/null 2>&1
fi
sleep 1

# 2. 极简极速安装 ntfy (自适应架构，纯粹的下载与解压)
if ! command -v ntfy &>/dev/null; then
  echo -e "${YELLOW}未检测到 ntfy，正在从官方下载...${NC}"
  ARCH=$(uname -m)
  case "$ARCH" in
  x86_64) NTFY_ARCH="amd64" ;;
  aarch64 | arm64) NTFY_ARCH="arm64" ;;
  *) NTFY_ARCH="amd64" ;; # 默认回退
  esac

  # 极简下载与安装逻辑
  wget -qO ntfy.tar.gz "https://ghp.ci/https://github.com/binwiederhier/ntfy/releases/download/v2.28.0/ntfy_linux_${NTFY_ARCH}.tar.gz"
  tar -xzf ntfy.tar.gz
  mv ntfy-*/ntfy /usr/local/bin/
  rm -rf ntfy*
  chmod +x /usr/local/bin/ntfy
  echo -e "${GREEN}ntfy 安装完毕！${NC}"
else
  echo -e "${GREEN}已检测到本地 ntfy，跳过安装。${NC}"
fi

NTFY_PATH=$(which ntfy)

# 3. 部署极简守护进程 (纯内存模式)
SERVICE_FILE="/etc/systemd/system/ntfy-local-web.service"
echo -e "${YELLOW}正在配置 Systemd 守护进程...${NC}"

# 摒弃了花哨的沙盒隔离，直接利用原生参数实现无痕内存运行
cat <<EOF >"$SERVICE_FILE"
[Unit]
Description=NTFY Local Secure Web Console (Simple RAM-Only)
After=network.target

[Service]
Type=simple
User=root
# 极简纯内存参数，直接置空缓存路径，不再写入磁盘
ExecStart=${NTFY_PATH} serve --listen-http 127.0.0.1:50080 --cache-file="" --attachment-cache-dir="" --cache-duration 1m
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

# 4. 启动服务
echo -e "${YELLOW}正在注册并启动服务...${NC}"
systemctl daemon-reload
systemctl enable ntfy-local-web.service >/dev/null 2>&1
systemctl start ntfy-local-web.service

sleep 1
if systemctl is-active --quiet ntfy-local-web.service; then
  echo ""
  echo -e "${GREEN}🎉 部署大功告成！控制台已稳定运行。${NC}"
  echo -e "${CYAN}------------------------------------------------------${NC}"
  echo -e "请在浏览器访问: ${YELLOW}http://127.0.0.1:50080${NC}"
  echo -e "建议配合浏览器的 ${YELLOW}无痕模式${NC} 使用，以保证本地绝对零留痕。"
  echo -e "${CYAN}------------------------------------------------------${NC}"
else
  echo -e "${RED}启动失败，请检查: systemctl status ntfy-local-web${NC}"
fi
