#!/bin/bash

# ==============================================================
# NTFY 终极报警配置 (V19 绝对防御版: PAM + X11 + 重连全覆盖)
# ==============================================================

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$EUID" -ne 0 ]; then
  echo -e "${RED}请使用 root 权限运行此脚本 (sudo bash setup_ntfy.sh)${NC}"
  exit 1
fi

echo -e "${CYAN}======================================================${NC}"
echo -e "${CYAN} 服务器登录报警自动化配置 (V19 绝对防御最终版)${NC}"
echo -e "${CYAN}======================================================${NC}"
echo ""

# 1. 自动依赖安装
check_and_install_deps() {
  local deps=("curl" "wget" "tar" "gzip" "xz" "awk" "ip")
  local missing_deps=()
  for dep in "${deps[@]}"; do
    if ! command -v "$dep" &>/dev/null; then missing_deps+=("$dep"); fi
  done
  if [ ${#missing_deps[@]} -eq 0 ]; then return; fi

  echo -e "${YELLOW}自动安装依赖: ${missing_deps[*]}...${NC}"
  if command -v apt-get &>/dev/null; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    for i in "${!missing_deps[@]}"; do
      if [ "${missing_deps[$i]}" = "xz" ]; then
        missing_deps[$i]="xz-utils"
      elif [ "${missing_deps[$i]}" = "ip" ]; then missing_deps[$i]="iproute2"; fi
    done
    apt-get install -y -qq "${missing_deps[@]}"
  elif command -v dnf &>/dev/null; then
    dnf install -y -q "${missing_deps[@]}"
  elif command -v yum &>/dev/null; then
    yum install -y -q "${missing_deps[@]}"
  fi
}
check_and_install_deps

# 2. 安装最新版 ntfy 客户端
install_ntfy_binary() {
  if ! command -v ntfy &>/dev/null; then
    echo -e "${YELLOW}正在动态获取最新版 ntfy 客户端...${NC}"
    ARCH=$(uname -m)
    case "$ARCH" in
    x86_64) NTFY_ARCH="amd64" ;;
    aarch64 | arm64) NTFY_ARCH="arm64" ;;
    *) NTFY_ARCH="amd64" ;;
    esac
    LATEST_URL=$(curl -s -m 5 https://api.github.com/repos/binwiederhier/ntfy/releases/latest | grep browser_download_url | grep "linux_${NTFY_ARCH}\.tar\.gz" | cut -d '"' -f 4)

    if [ -n "$LATEST_URL" ]; then
      if ! wget -qO ntfy.tar.gz "$LATEST_URL"; then
        wget -qO ntfy.tar.gz "https://ghp.ci/${LATEST_URL}"
      fi
    else
      FALLBACK_URL="https://ghp.ci/https://github.com/binwiederhier/ntfy/releases/download/v2.28.0/ntfy_linux_${NTFY_ARCH}.tar.gz"
      wget -qO ntfy.tar.gz "$FALLBACK_URL"
    fi

    mkdir -p ntfy_tmp
    tar -xzf ntfy.tar.gz -C ntfy_tmp
    mv ntfy_tmp/*/ntfy /usr/local/bin/ 2>/dev/null || mv ntfy_tmp/ntfy /usr/local/bin/
    rm -rf ntfy.tar.gz ntfy_tmp
    chmod +x /usr/local/bin/ntfy
    echo -e "${GREEN}ntfy 核心程序安装成功！${NC}"
  fi
}

# 3. 部署纯内存服务端 (可选)
read -p "是否自建 NTFY 消息中转服务端？(纯发送端选 n) [y/N]: " SETUP_SERVER
if [[ "$SETUP_SERVER" =~ ^[Yy]$ ]]; then
  install_ntfy_binary
  read -p "请输入监听端口 (默认 80): " SERVER_PORT
  SERVER_PORT=${SERVER_PORT:-80}

  mkdir -p /etc/ntfy
  cat <<EOF >/etc/ntfy/server.yml
listen-http: ":${SERVER_PORT}"
cache-duration: "4h"
EOF

  cat <<EOF >/etc/systemd/system/ntfy.service
[Unit]
Description=Ntfy Service
After=network.target
[Service]
ExecStart=/usr/local/bin/ntfy serve
Restart=always
User=root
[Install]
WantedBy=multi-user.target
EOF

  rm -rf /var/cache/ntfy
  systemctl daemon-reload
  systemctl enable --now ntfy
  systemctl restart ntfy
  echo -e "${GREEN}服务端已启动 (端口: ${SERVER_PORT}, 状态: 纯内存无痕模式)${NC}"
fi

# 4. 消息发送端及 OPSEC 信息配置
echo -e "${CYAN}配置发送端与设备标识...${NC}"
read -p "请输入接收 URL (可省略http头,如 ntfy.sh/mytopic): " TARGET_URL

if [[ ! "$TARGET_URL" =~ ^https?:// ]]; then
  if curl -s -o /dev/null -m 3 --insecure "https://${TARGET_URL}" &>/dev/null; then
    TARGET_URL="https://${TARGET_URL}"
  else
    TARGET_URL="http://${TARGET_URL}"
  fi
fi

read -p "请为该服务器起一个【自定义代号】: " CUSTOM_DEVICE_NAME
CUSTOM_DEVICE_NAME=${CUSTOM_DEVICE_NAME:-"Unnamed-Node"}

echo -e "${YELLOW}正在生成监控守护进程脚本...${NC}"

cat <<EOF >/usr/local/bin/login_notify.sh
#!/bin/bash
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CONF_TARGET="${TARGET_URL}"
CONF_DEVICE="${CUSTOM_DEVICE_NAME}"
EOF

cat <<'EOF' >>/usr/local/bin/login_notify.sh
get_public_ip() {
    local ip
    ip=$(curl -s -m 3 https://api.bilibili.com/x/web-interface/zone 2>/dev/null | grep -o '"addr":"[^"]*"' | cut -d'"' -f4)
    if [ -z "$ip" ]; then
        ip=$(curl -s -m 3 https://pv.sohu.com/cityjson 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -n1)
    fi
    if [ -z "$ip" ]; then
        ip=$(curl -s -m 3 https://1.1.1.1/cdn-cgi/trace 2>/dev/null | grep -E '^ip=' | cut -d= -f2)
    fi
    echo "$ip"
}

if [ "$1" = "boot_notify" ]; then
    sleep 10
    LOCAL_IP=$(ip -4 addr show scope global 2>/dev/null | grep inet | grep -v '127.0.0.1' | awk '{print $2}' | cut -d/ -f1 | head -n1)
    PUBLIC_IP=$(get_public_ip)
    PUB_LAST=$(echo "$PUBLIC_IP" | awk -F. '{print $4}')
    LOC_LAST=$(echo "$LOCAL_IP" | awk -F. '{print $4}')
    OPSEC_LOCATION="📍 定位: ${PUB_LAST:--} / ${LOC_LAST:--}"

    MSG="⚙ 事件: 系统开机/重启 (Boot Up)
$OPSEC_LOCATION
⏰ 时间: $(date +"%Y-%m-%d %H:%M:%S")"
    curl -H "Title: 🚀 服务器 [$CONF_DEVICE] 开机" -H "Priority: default" -H "Tags: rocket" -d "$MSG" "$CONF_TARGET" >/dev/null 2>&1
    exit 0
fi

if [ "$1" = "payload_exec" ]; then
    shift
    _USER="$1"
    _RHOST="$2"
    _SERVICE="$3"
    _PPID="$4"
    sleep 0.5
    
    LOCAL_IP=$(ip -4 addr show scope global 2>/dev/null | grep inet | grep -v '127.0.0.1' | awk '{print $2}' | cut -d/ -f1 | head -n1)
    PUBLIC_IP=$(get_public_ip)
    PUB_LAST=$(echo "$PUBLIC_IP" | awk -F. '{print $4}')
    LOC_LAST=$(echo "$LOCAL_IP" | awk -F. '{print $4}')
    OPSEC_LOCATION="📍 定位: ${PUB_LAST:--} / ${LOC_LAST:--}"

    if [ -n "$_RHOST" ]; then
        if echo "$_RHOST" | grep -q '\.'; then
            OPSEC_RHOST=$(echo "$_RHOST" | awk -F. '{print "xx.xx."$3"."$4}')
        else
            OPSEC_RHOST="[隐藏来源: 非标准IPv4]"
        fi
    else
        OPSEC_RHOST="本地屏幕直登"
    fi

    AUTH_METHOD="❓ 未知登录方式"
    if [ "$_SERVICE" = "sshd" ]; then
        AUTH_METHOD="📝 SSH 连接"
    elif [[ "$_SERVICE" == *"XRDP-新"* ]]; then
        AUTH_METHOD="🖥 远程桌面 (新建会话)"
    elif [[ "$_SERVICE" == *"XRDP-重连"* ]]; then
        AUTH_METHOD="🖥 远程桌面 (断线重连)"
    elif [[ "$_SERVICE" == *"VNC"* || "$_SERVICE" == *"vnc"* ]]; then
        AUTH_METHOD="🖥 远程桌面 (VNC)"
    elif [ "$_SERVICE" = "login" ]; then
        AUTH_METHOD="⌨ 物理机终端直登 (TTY)"
    else
        AUTH_METHOD="🎨 图形/其他会话 (触发: $_SERVICE)"
    fi

    MSG="👤 用户: $_USER
🌐 来源: $OPSEC_RHOST
🛠 服务: $_SERVICE
$AUTH_METHOD
$OPSEC_LOCATION
⏰ 时间: $(date +"%Y-%m-%d %H:%M:%S")"
    curl -H "Title: 🚨 服务器 [$CONF_DEVICE] 登录" -H "Priority: high" -H "Tags: warning" -d "$MSG" "$CONF_TARGET" >/dev/null 2>&1
    exit 0
fi

# PAM 拦截逻辑
if [ "$PAM_TYPE" = "open_session" ]; then
    case "$PAM_SERVICE" in
        cron|sudo|sudo-i|su|su-l|systemd-user|polkit-1|chsh|chfn|runuser*|ksu|sssd-shadowutils) exit 0 ;;
        *greeter*|*launch-environment*|*fingerprint*) exit 0 ;;
    esac
    nohup /usr/local/bin/login_notify.sh "payload_exec" "$PAM_USER" "$PAM_RHOST" "$PAM_SERVICE" "$PPID" </dev/null >/dev/null 2>&1 &
fi
exit 0
EOF

chmod 755 /usr/local/bin/login_notify.sh
chown root:root /usr/local/bin/login_notify.sh

# 5. 配置 Systemd 开机自启提醒
echo -e "${YELLOW}正在注册开机守护进程...${NC}"
cat <<EOF >/etc/systemd/system/ntfy-boot.service
[Unit]
Description=NTFY Boot Notification
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/login_notify.sh boot_notify
RemainAfterExit=no
[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable ntfy-boot.service >/dev/null 2>&1

# 6. 【全面清创】防止历史版本造成的重复报警
echo -e "${YELLOW}清理历史雷区，重置防御体系...${NC}"
sed -i '/login_notify.sh/d' /etc/pam.d/common-session /etc/pam.d/system-auth /etc/pam.d/password-auth /etc/pam.d/system-login /etc/pam.d/xrdp-sesman 2>/dev/null

# 7. 【第一重拦截】: 挂载到表面 PAM (专注 SSH 与物理端，绝不重复)
echo -e "${YELLOW}正在注入标准终端断点...${NC}"
PAM_FILES=("/etc/pam.d/sshd" "/etc/pam.d/login")
for pam_file in "${PAM_FILES[@]}"; do
  if [ -f "$pam_file" ]; then
    if ! grep -q "login_notify.sh" "$pam_file"; then
      echo "session    optional    pam_exec.so /usr/local/bin/login_notify.sh" >>"$pam_file"
    fi
  fi
done

# 8. 【第二重拦截】: 深入图形渲染层 (专注 XRDP 新建、重连与 VNC)
echo -e "${YELLOW}正在注入图形桌面双路防线...${NC}"

# XRDP 新建会话拦截
if [ -f /etc/xrdp/startwm.sh ]; then
  sed -i '/login_notify.sh/d' /etc/xrdp/startwm.sh
  sed -i '2i nohup /usr/local/bin/login_notify.sh "payload_exec" "$USER" "XRDP-新登录" "xrdp-desktop" "$$" </dev/null >/dev/null 2>&1 &' /etc/xrdp/startwm.sh
fi

# XRDP 断线重连拦截 (核心战果)
if [ -d /etc/xrdp ]; then
  if [ ! -f /etc/xrdp/reconnectwm.sh ]; then
    echo "#!/bin/sh" >/etc/xrdp/reconnectwm.sh
    chmod +x /etc/xrdp/reconnectwm.sh
  fi
  sed -i '/login_notify.sh/d' /etc/xrdp/reconnectwm.sh
  sed -i '2i nohup /usr/local/bin/login_notify.sh "payload_exec" "$USER" "XRDP-断线重连" "xrdp-reconnect" "$$" </dev/null >/dev/null 2>&1 &' /etc/xrdp/reconnectwm.sh
fi

# 泛 VNC/X11 会话拦截
if [ -d /etc/X11/Xsession.d ]; then
  echo 'nohup /usr/local/bin/login_notify.sh "payload_exec" "$USER" "VNC-GUI" "x11-session" "$$" </dev/null >/dev/null 2>&1 &' >/etc/X11/Xsession.d/99-ntfy-alert
fi

echo ""
echo -e "${GREEN}🎉 V19 终极绝对防御版 配置完成！${NC}"
echo -e "${CYAN}现已全面覆盖：开机重启、SSH、本地终端、XRDP(新建与重连)、VNC！${NC}"
